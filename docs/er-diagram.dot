"adaptation_event" -> "adaptation_rule" [label="N:1", fontsize=8];
"adaptation_event" -> "learner" [label="N:1", fontsize=8];
"adaptation_event" -> "quiz" [label="N:1", fontsize=8];
"review_item" -> "question" [label="N:1", fontsize=8];
"review_item" -> "attempt" [label="N:1", fontsize=8];
"review_item" -> "learner" [label="N:1", fontsize=8];
"review_item" -> "attempt" [label="N:1", fontsize=8];
"chat_session" -> "section" [label="N:1", fontsize=8];
"chat_session" -> "learner" [label="N:1", fontsize=8];
"message" -> "chat_session" [label="N:1", fontsize=8];
"message_source" -> "message" [label="N:1", fontsize=8];
