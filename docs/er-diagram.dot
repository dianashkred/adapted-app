subgraph "cluster_Chat" { label="Chat"; style="rounded,filled"; fillcolor="#D9C3E940"; color="#D9C3E9"; fontsize=14;
"chat_session" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9C3E9"><B>chat_session</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">mode</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">chat_mode NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_step</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">total_steps</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR></TABLE>>];
"message" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9C3E9"><B>message</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">message_role NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">latency_ms</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">prompt_tokens</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">completion_tokens</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">max_similarity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">float</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_refusal</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"message_source" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9C3E9"><B>message_source</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">chunk_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rank</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">similarity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">float NOT NULL</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Experiment" { label="Experiment"; style="rounded,filled"; fillcolor="#F4B6C240"; color="#F4B6C2"; fontsize=14;
"test_form" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F4B6C2"><B>test_form</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">course_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">test_kind NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"test_form_item" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F4B6C2"><B>test_form_item</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">form_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">question_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR></TABLE>>];
"simulated_gap" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F4B6C2"><B>simulated_gap</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR></TABLE>>];
}
