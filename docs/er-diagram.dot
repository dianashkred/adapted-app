digraph ER {
graph [rankdir=LR, fontname="Helvetica", fontsize=20, nodesep=0.35, ranksep=1.1, label="AdaptED — logical schema (PostgreSQL 16 + pgvector)", labelloc=t, pad=0.3];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#666666", arrowsize=0.6];
subgraph "cluster_Reference data" { label="Reference data"; style="rounded,filled"; fillcolor="#E7E6E640"; color="#E7E6E6"; fontsize=14;
"privacy_notice" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E7E6E6"><B>privacy_notice</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">published_on</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">summary</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR></TABLE>>];
"adaptation_rule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E7E6E6"><B>adaptation_rule</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Identity" { label="Identity"; style="rounded,filled"; fillcolor="#F8CBAD40"; color="#F8CBAD"; fontsize=14;
"account" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F8CBAD"><B>account</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">auth_subject</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email_encrypted</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">blob NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">account_role NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">consent_version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">consent_given_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"learner" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F8CBAD"><B>learner</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK UQ</TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_participant</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">experiment_mode</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">experiment_mode</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">mode_assigned_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">starting_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_simulated</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ui_theme</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ui_theme NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">revision_reminders</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Course materials" { label="Course materials"; style="rounded,filled"; fillcolor="#BDD7EE40"; color="#BDD7EE"; fontsize=14;
"course" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#BDD7EE"><B>course</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">owner_account_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">language</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">visibility</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">course_visibility NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"document" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#BDD7EE"><B>document</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">course_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">mime_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">size_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">storage_path</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">document_status NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">page_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">uploaded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">processed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR></TABLE>>];
"section" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#BDD7EE"><B>section</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">page_start</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">page_end</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR></TABLE>>];
"chunk" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#BDD7EE"><B>chunk</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">token_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">page</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">vector(384) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Assessment" { label="Assessment"; style="rounded,filled"; fillcolor="#FFE69940"; color="#FFE699"; fontsize=14;
"question" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFE699"><B>question</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">question_kind NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">question_source NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">prompt</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reference_answer</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"question_option" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFE699"><B>question_option</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">question_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">option_text</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_correct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR></TABLE>>];
"quiz" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFE699"><B>quiz</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">quiz_kind NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">quiz_status NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">max_questions</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">outcome</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">topic_status</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">end_reason</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">check_end_reason</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR></TABLE>>];
"quiz_item" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFE699"><B>quiz_item</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">quiz_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">question_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR></TABLE>>];
"attempt" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFE699"><B>attempt</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">question_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">quiz_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">selected_option</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">answer_text</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_correct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">evaluated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">evaluation_method NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">feedback</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">confidence</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">answer_confidence</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Learner model" { label="Learner model"; style="rounded,filled"; fillcolor="#C6E0B440"; color="#C6E0B4"; fontsize=14;
"topic_state" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#C6E0B4"><B>topic_state</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">topic_status NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">attempts_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">correct_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">consecutive_errors</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">last_attempt_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">next_review_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"adaptation_event" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#C6E0B4"><B>adaptation_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">section_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">quiz_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">rule</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">from_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">to_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">difficulty_level</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR></TABLE>>];
"review_item" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#C6E0B4"><B>review_item</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">learner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">question_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">review_reason NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">first_attempt_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">last_attempt_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">times_added</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">added_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">due_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR></TABLE>>];
