# Copy to .env and fill in. 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
MIGRATOR_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me
ANALYST_DB_PASSWORD=change-me

# passwords must match the ones above.
DATABASE_URL=postgresql+psycopg://adapted_app:change-me@localhost:5433/adapted
MIGRATOR_DATABASE_URL=postgresql+psycopg://adapted_migrator:change-me@localhost:5433/adapted
TEST_DATABASE_URL=postgresql+psycopg://adapted_app:change-me@localhost:5433/adapted_test
TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://adapted_migrator:change-me@localhost:5433/adapted_test
TEST_ANALYST_DATABASE_URL=postgresql+psycopg://adapted_analyst:change-me@localhost:5433/adapted_test

# Personal-data protection
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=
# any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_HASH_PEPPER=

# Learning (decision 0002): offer a revision quiz after this many days of absence
REVISION_ABSENCE_DAYS=7
